{
  "name": "assay",
  "version": "0.5.0",
  "private": true,
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "dev": "next dev",
    "dev:services": "docker compose up -d",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "eval": "vitest run --config vitest.evals.config.mts",
    "clean": "rm -rf .next node_modules/.cache",
    "sql:run": "DOTENV_CONFIG_PATH=.env.local tsx -r dotenv/config scripts/run-sql.ts",
    "sql:run-all": "DOTENV_CONFIG_PATH=.env.local tsx -r dotenv/config scripts/run-all-scripts.ts all",
    "sql:run-scheduled": "DOTENV_CONFIG_PATH=.env.local tsx -r dotenv/config scripts/run-all-scripts.ts scheduled",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "visual:baseline": "playwright test --update-snapshots=all",
    "visual": "playwright test",
    "e2e": "playwright test -c playwright.e2e.config.ts",
    "typecheck": "tsc --noEmit -p .",
    "user:set-role": "DOTENV_CONFIG_PATH=.env.local tsx -r dotenv/config scripts/set-user-role.ts",
    "telegram:webhook": "DOTENV_CONFIG_PATH=.env.local tsx -r dotenv/config scripts/telegram-webhook.ts",
    "migrate:collections": "DOTENV_CONFIG_PATH=.env.local tsx -r dotenv/config scripts/migrations/rename-collections.ts",
    "seed:demo": "DOTENV_CONFIG_PATH=.env.local tsx -r dotenv/config scripts/demo/seed-demo.ts"
  },
