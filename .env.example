# Copy to .env.local and fill in. Only the first four sections are required.

# Sign-in (docs/authentication.md). Secret: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
# At least one provider. Callbacks: <BETTER_AUTH_URL>/api/auth/callback/google|github
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Local development only: also offer email and password sign-in (ignored in production).
AUTH_DEV_PASSWORD_LOGIN=

# MongoDB: scripts, run history, roles. The database is the one in the URI's path,
# else MONGODB_DB_NAME, else sql_script_monitoring.
MONGODB_URI=mongodb+srv://user:password@cluster.example.mongodb.net/
# MONGODB_DB_NAME=sql_script_monitoring

# The built-in data source: the PostgreSQL database checks run against unless
# they name another one (Settings → Data sources). Any sslmode that asks for TLS (prefer,
# require, verify-ca, verify-full) connects with the certificate and host name
# verified; sslmode=disable is plaintext (local development only).
DATABASE_URL=postgresql://user:password@host/db?sslmode=require
# Optional: a role that may create tables, used only by `npm run seed:demo`.
# Point DATABASE_URL at a SELECT-only role and keep the owner here.
# SEED_DATABASE_URL=postgresql://owner:password@host/db?sslmode=require

# Upstash Redis cache
UPSTASH_REDIS_REST_URL=https://example.upstash.io
UPSTASH_REDIS_REST_TOKEN=

# Optional: error tracking with Sentry. When SENTRY_DSN is unset the SDK is
# disabled and nothing is sent. Set both to the same DSN value in production
# (Sentry → project → Settings → Client Keys); the browser uploader needs the
# public variable. Optional build-time settings for source map upload and
# release tracking: SENTRY_ORG, SENTRY_PROJECT, SENTRY_AUTH_TOKEN.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
# Optional tags read by src/sentry.client.config.ts (release and environment
# default when unset).
# NEXT_PUBLIC_SENTRY_RELEASE=
# NEXT_PUBLIC_SENTRY_ENVIRONMENT=

# Optional: AI features, through Vercel AI Gateway. Off unless AI_ENABLED=true,
# because every call spends Gateway credits. On Vercel the gateway
# authenticates with OIDC; elsewhere set AI_GATEWAY_API_KEY.
AI_ENABLED=
AI_GATEWAY_API_KEY=
# AI_GATEWAY_MODEL=anthropic/claude-haiku-4.5

# Optional: "true" makes this workspace the public demo: viewers may run the
# seeded demo checks (marked demoSeed), within hourly limits. Leave unset elsewhere.
DEMO_MODE=

# Optional, self-hosted demo only: how many proxies in front of Assay append
# to X-Forwarded-For (default 1; 0 trusts no forwarding header). Guests are
# rate limited by the address the outermost trusted proxy saw. Ignored on Vercel.
TRUSTED_PROXY_COUNT=

# Alerts (Settings → Notifications) and data sources. ASSAY_SECRET_KEY encrypts
# channel secrets and data source connection strings at rest and signs OAuth
# state; without it alerts are off and no data source can be added.
# Generate one with: openssl rand -base64 32
ASSAY_SECRET_KEY=
# Public URL of this deployment, used in alert links and OAuth redirects.
APP_URL=http://localhost:3000
# Lets the scheduled workflow run the alert outbox (POST /api/notifications/dispatch).
CRON_SECRET=

# Optional one-click connections; without them people paste a webhook URL.
# Slack app: incoming-webhook scope, redirect URL <APP_URL>/api/integrations/slack/callback
# (docs/notifications.md has a manifest).
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
# Enables Acknowledge / Mute buttons in Slack alerts (Basic Information → Signing Secret).
SLACK_SIGNING_SECRET=
# Discord application: redirect <APP_URL>/api/integrations/discord/callback
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Telegram bot from @BotFather. With TELEGRAM_WEBHOOK_SECRET set, run
# `npm run telegram:webhook` once; without it the settings page polls.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=

# Optional: days a run is kept before MongoDB deletes it (default 90; 0 keeps runs forever).
RUN_RETENTION_DAYS=

# Optional: running checks. Time for a check's whole script, in ms (1000–255000, so a run fits in one 300 s function);
# checks one instance runs at once; connections one instance opens to DATABASE_URL.
# CHECK_TIMEOUT_MS=30000
# CHECK_CONCURRENCY=4
# PG_POOL_MAX=10
# Connections one instance opens to each data source added in Settings.
# PG_SOURCE_POOL_MAX=3

# Optional: let added data sources reach hosts on private networks (10.x,
# 192.168.x, localhost, *.internal …). Off by default so a connection string
# cannot reach internal services or the cloud metadata endpoint; turn it on
# when self-hosting next to a private database. Such hosts may also skip TLS.
# ALLOW_PRIVATE_DATA_SOURCES=true

# Optional: comma-separated email domains allowed to use the app; empty allows all
ALLOWED_EMAIL_DOMAINS=

# Optional: https:// URL of the CA PostgreSQL's certificate is verified against,
# instead of the system CAs (plus CLIENT_CERT_BLOB_URL and CLIENT_KEY_BLOB_URL for a client certificate).
CA_CERT_BLOB_URL=
# CLIENT_CERT_BLOB_URL=
# CLIENT_KEY_BLOB_URL=
