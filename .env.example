# Copy to .env.local and fill in. Only the first four sections are required.

# Clerk (https://dashboard.clerk.com, or `clerk env pull`)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/dashboard

# MongoDB: scripts, run history, roles. Database name defaults to sql_script_monitoring.
MONGODB_URI=mongodb+srv://user:password@cluster.example.mongodb.net/

# PostgreSQL the checks run against
DATABASE_URL=postgresql://user:password@host/db?sslmode=require

# Upstash Redis cache
UPSTASH_REDIS_REST_URL=https://example.upstash.io
UPSTASH_REDIS_REST_TOKEN=

# Optional: AI features, through Vercel AI Gateway. Off unless AI_ENABLED=true,
# because every call spends Gateway credits. On Vercel the gateway
# authenticates with OIDC; elsewhere set AI_GATEWAY_API_KEY.
AI_ENABLED=
AI_GATEWAY_API_KEY=
# AI_GATEWAY_MODEL=anthropic/claude-haiku-4.5

# Optional: "true" makes this workspace the public demo: viewers may run the
# seeded demo checks (author demo-seed), 20 runs per hour each. Leave unset elsewhere.
DEMO_MODE=

# Optional: comma-separated email domains allowed to use the app; empty allows all
ALLOWED_EMAIL_DOMAINS=

# Optional: CA certificate URL when PostgreSQL needs one for SSL
CA_CERT_BLOB_URL=

# Optional: token for the standalone scheduler's management API
SCHEDULER_API_TOKEN=
